# Database Configuration
# For Render: Use the "Internal Database URL" from your PostgreSQL database
# For Local: Use your local PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/healweal

# Session Configuration
# IMPORTANT: Generate a strong random secret for production
# Use: openssl rand -base64 32
SESSION_SECRET=your-super-secret-key-change-this-in-production

# Node Environment
# Set to 'production' for Render, 'development' for local development
NODE_ENV=production

# Port Configuration
# Render automatically sets this, but defaults to 5000 locally
PORT=5000

# Initial Admin Bootstrap Credentials
# IMPORTANT: Provide strong credentials for the initial database/seed bootstrap.
# Never use default or predictable passwords in production.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=YourStrongInitialPasswordHere_ChangeMe!
