modules = ["nodejs-20", "web"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33447
externalPort = 8081

[[ports]]
localPort = 34775
externalPort = 8099

[[ports]]
localPort = 34973
externalPort = 5000

[[ports]]
localPort = 36909
externalPort = 3003

[[ports]]
localPort = 37221
externalPort = 5173

[[ports]]
localPort = 37461
externalPort = 8080

[[ports]]
localPort = 37767
externalPort = 4200

[[ports]]
localPort = 38471
externalPort = 8000

[[ports]]
localPort = 39205
externalPort = 6000

[[ports]]
localPort = 39511
externalPort = 3002

[[ports]]
localPort = 42769
externalPort = 6800

[[ports]]
localPort = 42879
externalPort = 3001

[[ports]]
localPort = 43623
externalPort = 3000

[[ports]]
localPort = 45177
externalPort = 8008

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000
